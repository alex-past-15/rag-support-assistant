# Local Ollama: no account, secret key, or paid API.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_MODEL=rag-support-qwen3
LLM_TIMEOUT_SECONDS=180
# Yandex folder ID, or optional OpenAI project ID.
LLM_PROJECT=
# Bearer for OpenAI-compatible endpoints. Change only per provider docs.
LLM_AUTH_SCHEME=Bearer
# Optional separate verifier model; empty means the same model, separate call.
LLM_VERIFY_MODEL=
# Optional cosine similarity threshold. Empty = disabled until calibration.
RAG_MIN_SCORE=
